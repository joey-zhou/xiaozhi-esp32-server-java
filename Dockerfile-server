# Use Eclipse Temurin for both build and runtime stages
FROM eclipse-temurin:21-jdk AS builder

# buildx 内置参数，需要在每个用到它的 stage 里重新声明才能取到值；
# 用来把原生库下载目标平台跟镜像的目标架构对齐，而不是固定下载 x64 的库
ARG TARGETARCH

# 构建参数
# Vosk模型大小: small(~50MB) 或 standard(~1.3GB)
ARG VOSK_MODEL_SIZE=small
# TTS本地模型，默认 vits-melo-tts-zh_en（中英文），设为 none 则不下载
ARG TTS_MODEL=vits-melo-tts-zh_en
# 模型下载代理（仅用于 curl，不影响 apt-get）
ARG DOWNLOAD_PROXY=

# 安装必要的构建工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    maven \
    wget \
    unzip \
    curl \
    lbzip2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# 复制项目本地仓库（sherpa-onnx 等未发布到 Maven Central 的依赖）
COPY repo/ ./repo/

# 先复制所有 pom.xml 以利用 Docker 缓存（依赖不变时跳过下载）
COPY pom.xml ./
COPY xiaozhi-common/pom.xml  ./xiaozhi-common/
COPY xiaozhi-service/pom.xml ./xiaozhi-service/
COPY xiaozhi-ai/pom.xml      ./xiaozhi-ai/
COPY xiaozhi-dialogue/pom.xml ./xiaozhi-dialogue/
COPY xiaozhi-server/pom.xml  ./xiaozhi-server/

# 预下载依赖（单独一层，源码变更时不重复下载）
RUN mvn -Dmaven.repo.local=/root/.m2/repository dependency:go-offline -DexcludeGroupIds=com.xiaozhi || true

# 复制所有模块源代码
COPY xiaozhi-common/src  ./xiaozhi-common/src
COPY xiaozhi-service/src ./xiaozhi-service/src
COPY xiaozhi-ai/src      ./xiaozhi-ai/src
COPY xiaozhi-dialogue/src ./xiaozhi-dialogue/src
COPY xiaozhi-server/src  ./xiaozhi-server/src

# 构建整个多模块项目：镜像构建没有接到 CI 门禁，这里不跳过测试，
# 避免测试不过的提交也能被直接打包成可运行镜像
RUN mvn -Dmaven.repo.local=/root/.m2/repository package

# ============================================================
# 下载模型和原生库
# 脚本会自动跳过已存在的文件，支持 Docker 缓存
# ============================================================
COPY scripts/ ./scripts/

RUN if [ -n "$DOWNLOAD_PROXY" ]; then \
        export http_proxy="$DOWNLOAD_PROXY" https_proxy="$DOWNLOAD_PROXY" HTTP_PROXY="$DOWNLOAD_PROXY" HTTPS_PROXY="$DOWNLOAD_PROXY"; \
        echo ">>> 使用代理: ${DOWNLOAD_PROXY}"; \
    fi && \
    mkdir -p /build/models /build/lib && \
    if [ "$TARGETARCH" = "arm64" ]; then NATIVE_PLATFORM=linux-aarch64; else NATIVE_PLATFORM=linux-x64; fi && \
    echo ">>> 下载原生库和 VAD 模型 (平台: ${NATIVE_PLATFORM}) ..." && \
    TARGET_PLATFORM="$NATIVE_PLATFORM" bash scripts/download_base.sh all && \
    echo ">>> 下载 Vosk STT 模型 (${VOSK_MODEL_SIZE}) ..." && \
    http_proxy="${DOWNLOAD_PROXY}" https_proxy="${DOWNLOAD_PROXY}" \
        bash scripts/download_stt.sh "$VOSK_MODEL_SIZE" && \
    if [ "$TTS_MODEL" != "none" ] && [ -n "$TTS_MODEL" ]; then \
        echo ">>> 下载 TTS 模型 (${TTS_MODEL}) ..." && \
        case "$TTS_MODEL" in \
            matcha-icefall-zh-en) \
                http_proxy="${DOWNLOAD_PROXY}" https_proxy="${DOWNLOAD_PROXY}" \
                    bash scripts/download_tts.sh matcha ;; \
            *) \
                http_proxy="${DOWNLOAD_PROXY}" https_proxy="${DOWNLOAD_PROXY}" \
                    bash scripts/download_tts.sh vits-melo ;; \
        esac; \
    else \
        echo ">>> 跳过 TTS 模型下载 (TTS_MODEL=none)"; \
    fi && \
    bash scripts/download_models.sh status

# ============================================================
# 公共运行时基础镜像
# ============================================================
FROM eclipse-temurin:21-jre AS runtime-base

# document_engine（Python，OCR 靠 tesseract）没有打进这个镜像，这里只是 Java 服务的运行时，
# 装 tesseract 也用不上；真要在这个镜像里跑 OCR，需要另外把 document_engine 连同 python3/uv 一起打包
RUN apt-get update && apt-get install -y --no-install-recommends \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libxfixes3 \
    libxtst6 \
    libxrender1 \
    libpulse0 \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/models /app/models
COPY --from=builder /build/lib /app/lib
ENV LD_LIBRARY_PATH=/app/lib:$LD_LIBRARY_PATH
ENV TZ=Asia/Shanghai

# ============================================================
# xiaozhi-server（管理后台 API，端口 8091）
# 构建: docker build --target server ...
# ============================================================
FROM runtime-base AS server

COPY --from=builder /build/xiaozhi-server/target/xiaozhi-server-*.jar /app/xiaozhi-server.jar

RUN echo '#!/bin/bash\n\
echo "Starting xiaozhi-server"\n\
java -Xms512m -Xmx1024m -XX:MaxDirectMemorySize=256m \\\n\
  -Dsherpa_onnx.native.path=/app/lib \\\n\
  -Djava.library.path=/app/lib \\\n\
  -jar /app/xiaozhi-server.jar\n\
' > /app/start.sh && chmod +x /app/start.sh

CMD ["/bin/bash", "/app/start.sh"]

# ============================================================
# xiaozhi-dialogue（设备对话服务，端口 8092）
# 构建: docker build --target dialogue ...
# ============================================================
FROM runtime-base AS dialogue

COPY --from=builder /build/xiaozhi-dialogue/target/xiaozhi-dialogue-*-exec.jar /app/xiaozhi-dialogue.jar

RUN echo '#!/bin/bash\n\
echo "Starting xiaozhi-dialogue"\n\
java -Xms512m -Xmx768m -XX:MaxDirectMemorySize=256m \\\n\
  -Dsherpa_onnx.native.path=/app/lib \\\n\
  -Djava.library.path=/app/lib \\\n\
  -jar /app/xiaozhi-dialogue.jar\n\
' > /app/start.sh && chmod +x /app/start.sh

CMD ["/bin/bash", "/app/start.sh"]
