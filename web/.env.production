# 生产环境配置
# 三个地址项都留空：前端一律走当前页面的同源地址，由前置 nginx（web/nginx.conf）
# 分别转发给 server(8091) 与 dialogue(8092)。这样同一份产物换 IP、换域名、
# 套外层反向代理都不用重新构建；确有跨域部署需求时再填具体地址。

# API 基础路径
VITE_API_BASE_URL=/api

# WebSocket 地址，留空按页面地址推导为 ws(s)://<当前host>/ws/xiaozhi/v1/
VITE_WS_URL=

# 后端静态资源前缀（录音、上传文件），留空走同源相对路径
VITE_BACKEND_URL=

# 应用标题
VITE_APP_TITLE=Connect Ai - 智能物联网管理平台
