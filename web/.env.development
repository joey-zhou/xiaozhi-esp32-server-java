# 开发环境配置
# API 基础路径（开发环境使用相对路径，通过 Vite proxy 转发）
VITE_API_BASE_URL=/api

# WebSocket 地址
# 对话进程（xiaozhi-dialogue）的端口，WebSocket 只注册在这个进程上，不是 API 进程 8091
# 留空则按页面地址推导（ws://localhost:8084/ws/...），由 vite 的 /ws 代理转给 8092，两种写法都能用
VITE_WS_URL=ws://127.0.0.1:8092/ws/xiaozhi/v1

# 应用标题
VITE_APP_TITLE=Connect Ai - 开发环境

# 后端服务地址（用于静态资源访问）
VITE_BACKEND_URL=http://localhost:8091
