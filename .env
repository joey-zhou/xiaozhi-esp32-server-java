# Docker 构建代理，用于从 GitHub 下载模型
# 填写本地代理地址，例如 http://host.docker.internal:10808
BUILD_PROXY=

# 宿主机 IP 地址（供 Docker 容器内使用）
# Mac Docker Desktop 无法自动获取宿主机局域网 IP（host.docker.internal 指向 VM 网关，不是真实 LAN IP）
# 如需让同局域网内的 ESP32 设备连接，请填写本机局域网 IP（例如 192.168.1.100）
# 留空则自动检测：Linux Docker 用 host.docker.internal，否则尝试获取公网 IP
HOST_IP=

# 设备接入鉴权密钥（HMAC-SHA256），server 与 dialogue 必须同值
# 本文件被 git 跟踪，真实密钥不要写在这里：启动前在 shell 里导出，compose 优先读 shell 变量
#   export XIAOZHI_DEVICE_AUTH_SECRET=$(openssl rand -hex 16)
# 未导出时 docker compose 直接报错退出
XIAOZHI_DEVICE_AUTH_SECRET=
