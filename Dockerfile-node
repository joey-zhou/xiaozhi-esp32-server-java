FROM node:22-alpine AS builder

WORKDIR /node

# 先只复制锁文件装依赖，源码变更时命中缓存不用重装；npm ci 严格按 package-lock.json 安装，
# 不会像 npm install 那样在版本漂移时静默改写锁文件
COPY package.json package-lock.json ./
RUN npm config set registry https://registry.npmmirror.com && \
    npm ci

# 构建产物含子工程 xiaozhi-assets-generator（build 脚本里的 build:tools 步骤）
COPY . .
RUN npm run build

# 生产阶段
FROM nginx:alpine

COPY --from=builder /node/dist /usr/share/nginx/html

# nginx 配置：SPA路由 + 反向代理API
RUN echo 'server { \
    listen 8084; \
    root /usr/share/nginx/html; \
    index index.html; \
    client_max_body_size 100M; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    location /api/ { \
        proxy_pass http://server:8091; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 8084

CMD ["nginx", "-g", "daemon off;"]